{
  "_doc": "Maps GDELT GKG theme codes (GKG theme taxonomy incl. World Bank 'WB_' topics) to GICS-style sectors and to event-class evidence. 'pattern' is a regex matched against each theme code. GKG themes are machine-extracted from whole web pages and are noisy for a single article, so: a sector is tagged only when the SUM over DISTINCT matching themes reaches min_sector_weight (core ECON_/ENV_ themes weigh 1.0, broad World Bank topics 0.5, very broad ones 0.3), and theme evidence for event classes is scaled by event_theme_scale. Edit freely: this is the only place the semantics of GKG themes live.",
  "min_sector_weight": 1.5,
  "max_sectors": 3,
  "event_theme_scale": 0.5,
  "sector_themes": [
    {"sector": "Energy", "weight": 1.0, "pattern": "^(ENV_OIL|ECON_OILPRICE|FUELPRICES|ECON_HEATINGOIL|ENV_NATURALGAS|ENV_COAL)"},
    {"sector": "Energy", "weight": 0.5, "pattern": "^WB_(507_ENERGY_AND_EXTRACTIVES|539_OIL|548_PPP_IN_OIL|2298_REFINERIES|2299_PIPELINES)"},
    {"sector": "Financials", "weight": 1.0, "pattern": "^(ECON_STOCKMARKET|ECON_INTEREST_RATES|ECON_CENTRALBANK|ECON_BANKRUPTCY|EPU_CATS_MONETARY_POLICY|EPU_POLICY_INTEREST_RATES|EPU_POLICY_CENTRAL_BANK)"},
    {"sector": "Financials", "weight": 0.5, "pattern": "^WB_(1920_FINANCIAL_SECTOR|318_FINANCIAL_ARCHITECTURE|1234_BANKING|1235_CENTRAL_BANKS|332_CAPITAL_MARKETS|336_NON_BANK|337_INSURANCE|1973_FINANCIAL_RISK|328_FINANCIAL_INTEGRITY|1045_TREASURY)"},
    {"sector": "Financials", "weight": 0.3, "pattern": "^(ECON_DEBT|ECON_WORLDCURRENCIES)|^WB_(450_DEBT|1104_MACROECONOMIC_VULNERABILITY_AND_DEBT)"},
    {"sector": "Information Technology", "weight": 1.0, "pattern": "^CYBER_ATTACK"},
    {"sector": "Information Technology", "weight": 0.5, "pattern": "^WB_(670_ICT_SECURITY|667_ICT_INFRASTRUCTURE|652_ICT_APPLICATIONS|672_NETWORK_MANAGEMENT)"},
    {"sector": "Communication Services", "weight": 0.5, "pattern": "^WB_(286_TELECOMMUNICATIONS|662_SOCIAL_MEDIA)"},
    {"sector": "Communication Services", "weight": 0.3, "pattern": "^(MEDIA_SOCIAL)|^WB_694_BROADCAST"},
    {"sector": "Health Care", "weight": 1.0, "pattern": "^(HEALTH_PANDEMIC|TAX_DISEASE_COVID)"},
    {"sector": "Health Care", "weight": 0.5, "pattern": "^WB_(1350_PHARMACEUTICALS|1331_HEALTH_TECHNOLOGIES|2167_PANDEMICS|2165_HEALTH_EMERGENCIES|1305_HEALTH_SERVICES|1287_HEALTH_INSURANCE|625_HEALTH_ECONOMICS)|^EPU_CATS_HEALTHCARE"},
    {"sector": "Health Care", "weight": 0.3, "pattern": "^WB_(635_PUBLIC_HEALTH|1406_DISEASES|1431_CANCER)"},
    {"sector": "Industrials", "weight": 1.0, "pattern": "^MARITIME$"},
    {"sector": "Industrials", "weight": 0.5, "pattern": "^WB_(165_AIR_TRANSPORT|1804_AIRPORTS|167_PORTS|793_TRANSPORT_AND_LOGISTICS|772_TRADE_FACILITATION|1174_WAREHOUSING|164_MODES_OF_TRANSPORT)"},
    {"sector": "Industrials", "weight": 0.3, "pattern": "^WB_(1281_MANUFACTURING|346_COMPETITIVE_INDUSTRIES|818_INDUSTRY_POLICY)"},
    {"sector": "Materials", "weight": 1.0, "pattern": "^(ENV_MINING|ENV_METALS)"},
    {"sector": "Materials", "weight": 0.5, "pattern": "^WB_(895_MINING|1699_METAL_ORE|2936_GOLD|2937_SILVER)"},
    {"sector": "Consumer Staples", "weight": 1.0, "pattern": "^(AGRICULTURE|FOOD_SECURITY)$"},
    {"sector": "Consumer Staples", "weight": 0.5, "pattern": "^WB_(435_AGRICULTURE|1967_AGRICULTURAL_RISK|1949_CLIMATE_SMART_AGRICULTURE)"},
    {"sector": "Consumer Discretionary", "weight": 1.0, "pattern": "^TOURISM$"},
    {"sector": "Consumer Discretionary", "weight": 0.3, "pattern": "^ECON_COST_OF_LIVING"},
    {"sector": "Real Estate", "weight": 1.0, "pattern": "^ECON_HOUSING_PRICES"},
    {"sector": "Real Estate", "weight": 0.5, "pattern": "^WB_612_HOUSING_FINANCE"},
    {"sector": "Utilities", "weight": 1.0, "pattern": "^ENV_(SOLAR|WINDPOWER|HYDRO|GEOTHERMAL|NUCLEARPOWER)"},
    {"sector": "Utilities", "weight": 0.5, "pattern": "^WB_(137_WATER$|.*ELECTRICITY)|^WATER_SECURITY"}
  ],
  "event_themes": [
    {"event_type": "INTEREST_RATE", "weight": 2.5, "pattern": "^(ECON_INTEREST_RATES|ECON_CENTRALBANK|EPU_CATS_MONETARY_POLICY|EPU_POLICY_INTEREST_RATES|EPU_POLICY_CENTRAL_BANK)$"},
    {"event_type": "COMMODITY_ENERGY", "weight": 2.5, "pattern": "^(ECON_OILPRICE|FUELPRICES|ECON_HEATINGOIL)$"},
    {"event_type": "COMMODITY_ENERGY", "weight": 1.2, "pattern": "^(ENV_OIL|ENV_NATURALGAS|ENV_COAL)$|^WB_(2298_REFINERIES|2299_PIPELINES|2936_GOLD)"},
    {"event_type": "MACROECONOMIC", "weight": 2.0, "pattern": "^(ECON_INFLATION|UNEMPLOYMENT)$|^WB_(442_INFLATION|471_ECONOMIC_GROWTH)"},
    {"event_type": "MACROECONOMIC", "weight": 1.0, "pattern": "^(ECON_STOCKMARKET|ECON_DEBT|ECON_COST_OF_LIVING|EPU_CATS_FISCAL_POLICY)$|^WB_(445_FISCAL_POLICY|1104_MACROECONOMIC)"},
    {"event_type": "CREDIT_EVENT", "weight": 2.5, "pattern": "^ECON_BANKRUPTCY"},
    {"event_type": "CYBER_OPERATIONAL", "weight": 3.0, "pattern": "^CYBER_ATTACK$"},
    {"event_type": "CYBER_OPERATIONAL", "weight": 1.0, "pattern": "^(STRIKE|DISASTER_FIRE)$|^WB_670_ICT_SECURITY"},
    {"event_type": "NATURAL_DISASTER", "weight": 2.5, "pattern": "^(NATURAL_DISASTER|HEALTH_PANDEMIC)(_|$)|^TAX_DISEASE_COVID|^WB_2167_PANDEMICS"},
    {"event_type": "NATURAL_DISASTER", "weight": 1.5, "pattern": "^WB_2165_HEALTH_EMERGENCIES"},
    {"event_type": "REGULATORY", "weight": 1.5, "pattern": "^(EPU_CATS_REGULATION|EPU_POLICY_REGULATORY)$|^WB_(845_LEGAL_AND_REGULATORY|2020_BRIBERY_FRAUD)"},
    {"event_type": "REGULATORY", "weight": 0.8, "pattern": "^(BAN|LEGISLATION)$|^WB_2025_INVESTIGATION"},
    {"event_type": "GEOPOLITICAL", "weight": 2.0, "pattern": "^SANCTIONS"},
    {"event_type": "GEOPOLITICAL", "weight": 1.0, "pattern": "^(ARMEDCONFLICT|TERROR|CEASEFIRE)$|^WB_(2462_POLITICAL_VIOLENCE_AND_WAR|2467_TERRORISM)"}
  ]
